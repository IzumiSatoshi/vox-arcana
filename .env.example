# Server only: select direct Jev or Vercel AI Gateway. Never expose these in public/.
# JEV_ENDPOINT=direct
# JEV_ENDPOINT=gateway
# Default: gateway on Vercel; locally, direct if a Jev key is available.
# Direct TypeSafe authentication (either name is supported).
JEV_API_KEY=
# TYPESAFE_API_KEY=
# Gateway mode on Vercel uses its deployment OIDC token and AI Gateway budget.
# Direct mode bills your Jev account; the AI Gateway budget does not apply.
# AI_GATEWAY_API_KEY is a local fallback for testing the hosted handler.
# AI_GATEWAY_API_KEY=
JEV_MODEL=jev-latest
JEV_URL=https://api.typesafe.ai/v1/systemone

# Shared spell cache: connect an Upstash Redis database through Vercel Storage.
# Keep these credentials on the server; KV_REST_API_URL/TOKEN aliases also work.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Optional release identifier for non-Vercel hosting. Change on every update.
# Vercel automatically uses VERCEL_DEPLOYMENT_ID (or VERCEL_URL).
# JEV_CACHE_VERSION=

# WebRTC relay fallback (Cloudflare Realtime TURN). Server-only secrets.
# Without these, direct connections work but some networks cannot connect.
# TURN_KEY_ID=
# TURN_KEY_API_TOKEN=

# Legacy standalone online server (npm run online); unused by the P2P website.
# ONLINE_ORIGINS=https://your-game.example,http://localhost:8787
# ONLINE_REGION=Tokyo
# ONLINE_MAX_ROOMS=8
# ONLINE_INTERPRETER=jev
